<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description"
content="Neshik S S — Creative Developer, BCA Student, Web Developer and UI/UX Designer.">

<title>NESHIK® — Digital Portfolio</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

/* =========================================================
   ROOT
========================================================= */

:root{
    --black:#101010;
    --black2:#171717;
    --cream:#f1ede4;
    --cream2:#e7e1d5;
    --white:#fff;
    --gray:#85817a;
    --gray2:#aaa59c;
    --line-dark:rgba(241,237,228,.15);
    --line-light:rgba(16,16,16,.15);
    --lime:#d9ff50;
    --red:#ff4d3d;

    --ease:cubic-bezier(.16,.75,.18,1);
}

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--black);
    color:var(--cream);
    font-family:"DM Sans",sans-serif;
    overflow-x:hidden;
}

body.menu-open{
    overflow:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input{
    font-family:inherit;
}

button{
    border:0;
    background:none;
    color:inherit;
    cursor:pointer;
}

img{
    max-width:100%;
    display:block;
}

::selection{
    background:var(--lime);
    color:#111;
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar{
    width:7px;
}

::-webkit-scrollbar-track{
    background:var(--black);
}

::-webkit-scrollbar-thumb{
    background:#555;
    border-radius:20px;
}

/* =========================================================
   LOADER
========================================================= */

.loader{
    position:fixed;
    inset:0;
    z-index:99999;
    background:var(--black);
    display:flex;
    align-items:center;
    justify-content:center;
    transition:transform 1s var(--ease);
}

.loader.done{
    transform:translateY(-100%);
}

.loader-number{
    font-size:clamp(80px,15vw,190px);
    font-weight:700;
    letter-spacing:-.1em;
    line-height:.7;
}

.loader-text{
    margin-top:25px;
    text-align:center;
    color:var(--gray);
    font-size:9px;
    letter-spacing:.35em;
    text-transform:uppercase;
}

/* =========================================================
   NAV
========================================================= */

.nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:5000;
    padding:25px 4vw;
    display:flex;
    justify-content:space-between;
    align-items:center;
    mix-blend-mode:difference;
}

.logo{
    font-size:21px;
    font-weight:700;
    letter-spacing:-.07em;
}

.nav-links{
    display:flex;
    gap:32px;
}

.nav-links a{
    font-size:10px;
    letter-spacing:.18em;
    text-transform:uppercase;
    position:relative;
}

.nav-links a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:-7px;
    height:1px;
    width:0;
    background:white;
    transition:.3s;
}

.nav-links a:hover::after{
    width:100%;
}

.menu{
    display:none;
    font-size:10px;
    letter-spacing:.18em;
}

/* =========================================================
   HERO
========================================================= */

.hero{
    min-height:100svh;
    padding:145px 4vw 55px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
}

.hero-top{
    display:flex;
    justify-content:space-between;
}

.status{
    font-size:10px;
    color:var(--gray);
    text-transform:uppercase;
    letter-spacing:.18em;
}

.status::before{
    content:"";
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--lime);
    display:inline-block;
    margin-right:8px;
    animation:pulse 1.5s infinite;
}

@keyframes pulse{
    50%{opacity:.3;transform:scale(.7)}
}

.hero-location{
    color:var(--gray);
    font-size:10px;
    text-align:right;
    text-transform:uppercase;
    letter-spacing:.15em;
    line-height:1.7;
}

.hero h1{
    font-size:clamp(75px,14vw,210px);
    line-height:.73;
    letter-spacing:-.11em;
    font-weight:700;
}

.hero h1 em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.hero-indent{
    margin-left:12vw;
}

.hero-bottom{
    display:flex;
    justify-content:space-between;
    align-items:end;
}

.hero-copy{
    width:350px;
    color:var(--gray2);
    font-size:14px;
    line-height:1.7;
}

.scroll{
    color:var(--gray);
    font-size:9px;
    letter-spacing:.2em;
    text-transform:uppercase;
}

/* =========================================================
   MARQUEE
========================================================= */

.marquee{
    border-top:1px solid var(--line-dark);
    border-bottom:1px solid var(--line-dark);
    overflow:hidden;
    white-space:nowrap;
    padding:24px 0;
}

.marquee-track{
    display:inline-flex;
    animation:marquee 30s linear infinite;
}

.marquee span{
    margin-right:65px;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.28em;
    color:var(--gray);
}

.marquee strong{
    color:var(--cream);
}

@keyframes marquee{
    to{
        transform:translateX(-50%);
    }
}

/* =========================================================
   GENERAL
========================================================= */

.section{
    padding:150px 4vw;
}

.label{
    color:var(--gray);
    font-size:9px;
    letter-spacing:.3em;
    text-transform:uppercase;
    margin-bottom:60px;
}

/* =========================================================
   REVEAL
========================================================= */

.reveal{
    opacity:0;
    transform:translateY(40px);
    transition:
        opacity .9s ease,
        transform 1s var(--ease);
}

.reveal.show{
    opacity:1;
    transform:none;
}

/* =========================================================
   ABOUT
========================================================= */

.about{
    display:grid;
    grid-template-columns:1fr 2fr;
    gap:8vw;
}

.about-title{
    font-size:clamp(55px,8vw,120px);
    line-height:.8;
    letter-spacing:-.1em;
}

.about-title em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.about-big{
    font-size:clamp(25px,3.5vw,50px);
    line-height:1.08;
    letter-spacing:-.05em;
}

.about-small{
    max-width:700px;
    margin-top:40px;
    color:var(--gray);
    line-height:1.8;
    font-size:14px;
}

.about-info{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    margin-top:70px;
    border-top:1px solid var(--line-dark);
}

.info{
    padding-top:20px;
}

.info-label{
    color:var(--gray);
    font-size:9px;
    letter-spacing:.18em;
    text-transform:uppercase;
    margin-bottom:10px;
}

.info-value{
    font-size:13px;
}

/* =========================================================
   PHOTO
========================================================= */

.photo-area{
    padding-top:10px;
}

.photo-layout{
    display:grid;
    grid-template-columns:1.4fr .6fr;
    gap:30px;
    align-items:end;
}

.photo{
    position:relative;
    overflow:hidden;
    aspect-ratio:16/10;
    background:#222;
}

.photo img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform 1s var(--ease);
}

.photo:hover img{
    transform:scale(1.045);
}

.photo-caption{
    position:absolute;
    bottom:20px;
    left:20px;
    right:20px;
    display:flex;
    justify-content:space-between;
}

.tag{
    background:rgba(10,10,10,.7);
    backdrop-filter:blur(10px);
    padding:9px 12px;
    font-size:8px;
    letter-spacing:.18em;
    text-transform:uppercase;
}

.photo-side{
    font-size:clamp(30px,4vw,65px);
    line-height:.9;
    letter-spacing:-.07em;
}

.photo-side em{
    font-family:"Playfair Display",serif;
}

/* =========================================================
   SKILLS
========================================================= */

.light{
    background:var(--cream);
    color:var(--black);
}

.light .label{
    color:#77736c;
}

.skills-title{
    font-size:clamp(65px,10vw,150px);
    line-height:.76;
    letter-spacing:-.1em;
}

.skills-title em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.skills-list{
    margin-top:110px;
    border-top:1px solid var(--line-light);
}

.skill{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:24px 0;
    border-bottom:1px solid var(--line-light);
    transition:.4s var(--ease);
}

.skill:hover{
    padding-left:25px;
    padding-right:25px;
}

.skill-name{
    font-size:clamp(26px,4vw,58px);
    letter-spacing:-.06em;
}

.skill-no{
    color:#77736c;
    font-size:9px;
}

/* =========================================================
   PROJECT SECTION
========================================================= */

.projects-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
}

.projects-title{
    font-size:clamp(70px,11vw,165px);
    line-height:.72;
    letter-spacing:-.11em;
}

.projects-title em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.projects-intro{
    width:300px;
    color:var(--gray);
    line-height:1.7;
    font-size:13px;
}

/* =========================================================
   PROJECT CONTROLS
========================================================= */

.project-controls{
    margin-top:90px;
    display:flex;
    justify-content:space-between;
    gap:25px;
    align-items:center;
    border-bottom:1px solid var(--line-dark);
    padding-bottom:20px;
}

.filters{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
}

.filter{
    padding:9px 14px;
    border:1px solid var(--line-dark);
    border-radius:30px;
    color:var(--gray);
    font-size:9px;
    letter-spacing:.12em;
    text-transform:uppercase;
    transition:.3s;
}

.filter:hover,
.filter.active{
    background:var(--cream);
    color:var(--black);
}

.search{
    width:230px;
    background:transparent;
    border:0;
    border-bottom:1px solid var(--line-dark);
    outline:none;
    padding:10px 0;
    color:var(--cream);
    font-size:12px;
}

.search::placeholder{
    color:var(--gray);
}

/* =========================================================
   PROJECT GRID
========================================================= */

.project-grid{
    margin-top:65px;
    display:grid;
    grid-template-columns:repeat(12,1fr);
    gap:35px 25px;
}

.project-card{
    grid-column:span 4;
    cursor:pointer;
    transition:opacity .4s,transform .5s var(--ease);
}

.project-card:nth-child(3n+2){
    margin-top:100px;
}

.project-card:nth-child(5n+1){
    grid-column:span 5;
}

.project-card:nth-child(5n+2){
    grid-column:span 4;
}

.project-card:nth-child(5n+3){
    grid-column:span 3;
}

.project-card.hide{
    display:none;
}

.project-image{
    height:330px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 30% 20%,#d9ff50,#151515 55%);
}

.project-card:nth-child(2n) .project-image{
    background:
        radial-gradient(circle at 70% 30%,#8a6cff,#111 55%);
}

.project-card:nth-child(3n) .project-image{
    background:
        linear-gradient(135deg,#e7e1d5,#555148);
}

.project-card:nth-child(4n) .project-image{
    background:
        radial-gradient(circle at 70% 70%,#ff614f,#171717 60%);
}

.project-card:nth-child(5n) .project-image{
    background:
        radial-gradient(circle at 50% 50%,#43e5ff,#111 60%);
}

.project-image::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(
            135deg,
            transparent,
            rgba(255,255,255,.08)
        );
}

.project-symbol{
    position:absolute;
    z-index:2;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:105px;
    height:105px;
    border:1px solid rgba(255,255,255,.55);
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:30px;
    color:white;
    backdrop-filter:blur(7px);
    transition:
        transform .7s var(--ease);
}

.project-card:hover .project-symbol{
    transform:
        translate(-50%,-50%)
        rotate(12deg)
        scale(1.12);
}

.project-card:hover .project-image{
    transform:scale(1.01);
}

.project-info{
    padding:17px 0;
    display:flex;
    justify-content:space-between;
    border-bottom:1px solid var(--line-dark);
    gap:20px;
}

.project-name{
    font-size:16px;
    letter-spacing:-.03em;
}

.project-meta{
    color:var(--gray);
    font-size:8px;
    letter-spacing:.16em;
    text-transform:uppercase;
    text-align:right;
}

.project-description{
    color:var(--gray);
    font-size:11px;
    line-height:1.6;
    margin-top:10px;
}

/* =========================================================
   PROJECT COUNT
========================================================= */

.project-count{
    margin-top:35px;
    color:var(--gray);
    font-size:10px;
    letter-spacing:.2em;
    text-transform:uppercase;
}

/* =========================================================
   PROJECT MODAL
========================================================= */

.modal{
    position:fixed;
    inset:0;
    z-index:9000;
    background:rgba(0,0,0,.85);
    backdrop-filter:blur(15px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:25px;
    opacity:0;
    visibility:hidden;
    transition:.5s;
}

.modal.open{
    opacity:1;
    visibility:visible;
}

.modal-box{
    background:var(--cream);
    color:var(--black);
    width:min(850px,100%);
    max-height:90vh;
    overflow:auto;
    padding:55px;
    position:relative;
    transform:translateY(40px);
    transition:.6s var(--ease);
}

.modal.open .modal-box{
    transform:none;
}

.modal-close{
    position:absolute;
    top:20px;
    right:25px;
    font-size:22px;
}

.modal-category{
    font-size:9px;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:#77736c;
}

.modal-title{
    margin-top:25px;
    font-size:clamp(40px,6vw,80px);
    line-height:.85;
    letter-spacing:-.08em;
}

.modal-text{
    margin-top:35px;
    max-width:650px;
    font-size:16px;
    line-height:1.7;
    color:#555;
}

.modal-tech{
    margin-top:35px;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.tech{
    border:1px solid var(--line-light);
    padding:8px 12px;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:.1em;
}

/* =========================================================
   JOURNEY
========================================================= */

.journey{
    background:var(--cream);
    color:var(--black);
}

.journey-grid{
    display:grid;
    grid-template-columns:1fr 2fr;
    gap:8vw;
}

.journey-title{
    font-size:clamp(60px,8vw,125px);
    line-height:.78;
    letter-spacing:-.1em;
}

.journey-title em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.timeline{
    border-top:1px solid var(--line-light);
}

.timeline-row{
    display:grid;
    grid-template-columns:80px 1fr 110px;
    gap:20px;
    padding:32px 0;
    border-bottom:1px solid var(--line-light);
}

.year{
    color:#77736c;
    font-size:9px;
}

.role{
    font-size:22px;
    letter-spacing:-.04em;
}

.type{
    color:#77736c;
    text-align:right;
    font-size:8px;
    letter-spacing:.14em;
    text-transform:uppercase;
}

/* =========================================================
   CONTACT
========================================================= */

.contact{
    min-height:100svh;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
}

.contact-title{
    font-size:clamp(70px,12vw,185px);
    line-height:.72;
    letter-spacing:-.11em;
}

.contact-title em{
    font-family:"Playfair Display",serif;
    font-weight:500;
}

.email{
    display:inline-block;
    margin-top:80px;
    font-size:clamp(23px,4vw,55px);
    letter-spacing:-.06em;
    border-bottom:2px solid var(--cream);
    padding-bottom:8px;
}

.email:hover{
    opacity:.55;
}

.footer{
    padding-top:25px;
    border-top:1px solid var(--line-dark);
    display:flex;
    justify-content:space-between;
}

.socials{
    display:flex;
    gap:30px;
}

.socials a{
    font-size:9px;
    letter-spacing:.15em;
    text-transform:uppercase;
}

.socials a:hover{
    text-decoration:underline;
}

.copy{
    color:var(--gray);
    font-size:9px;
}

/* =========================================================
   MOBILE
========================================================= */

@media(max-width:800px){

    .nav{
        padding:20px;
    }

    .menu{
        display:block;
    }

    .nav-links{
        position:fixed;
        inset:0;
        background:var(--black);
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
        gap:30px;
        transform:translateY(-100%);
        transition:.7s var(--ease);
    }

    .nav-links.open{
        transform:none;
    }

    .nav-links a{
        font-size:28px;
        letter-spacing:-.04em;
        text-transform:none;
    }

    .hero{
        padding:110px 20px 40px;
    }

    .hero-location{
        display:none;
    }

    .hero h1{
        font-size:19vw;
    }

    .hero-indent{
        margin-left:5vw;
    }

    .hero-bottom{
        flex-direction:column;
        align-items:flex-start;
        gap:35px;
        margin-top:80px;
    }

    .hero-copy{
        width:100%;
        max-width:350px;
    }

    .section{
        padding:100px 20px;
    }

    .about{
        grid-template-columns:1fr;
        gap:50px;
    }

    .about-info{
        grid-template-columns:repeat(2,1fr);
        gap:30px;
    }

    .photo-layout{
        grid-template-columns:1fr;
    }

    .photo{
        aspect-ratio:4/5;
    }

    .photo-side{
        max-width:300px;
    }

    .skills-list{
        margin-top:70px;
    }

    .projects-head{
        display:block;
    }

    .projects-intro{
        margin-top:35px;
        width:auto;
    }

    .project-controls{
        display:block;
    }

    .search{
        margin-top:25px;
        width:100%;
    }

    .project-grid{
        display:block;
    }

    .project-card,
    .project-card:nth-child(3n+2),
    .project-card:nth-child(5n+1),
    .project-card:nth-child(5n+2),
    .project-card:nth-child(5n+3){
        margin:0 0 65px;
    }

    .project-image{
        height:390px;
    }

    .journey-grid{
        grid-template-columns:1fr;
        gap:60px;
    }

    .timeline-row{
        grid-template-columns:60px 1fr;
    }

    .type{
        grid-column:2;
        text-align:left;
    }

    .modal-box{
        padding:35px 25px;
    }

    .email{
        word-break:break-word;
    }

    .footer{
        flex-direction:column;
        gap:30px;
    }

    .socials{
        flex-wrap:wrap;
    }
}

/* =========================================================
   REDUCED MOTION
========================================================= */

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        animation-duration:.01ms!important;
        transition-duration:.01ms!important;
        scroll-behavior:auto!important;
    }
}

</style>
</head>

<body>

<!-- =======================================================
     LOADER
======================================================= -->

<div class="loader" id="loader">

    <div>

        <div class="loader-number" id="loaderNumber">
            0
        </div>

        <div class="loader-text">
            Neshik / Digital Portfolio
        </div>

    </div>

</div>


<!-- =======================================================
     NAVIGATION
======================================================= -->

<nav class="nav">

    <a href="#home" class="logo">
        NESHIK®
    </a>

    <div class="nav-links" id="navLinks">

        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#journey">Journey</a>
        <a href="#contact">Contact</a>

    </div>

    <button class="menu" id="menu">
        MENU
    </button>

</nav>


<!-- =======================================================
     HERO
======================================================= -->

<header class="hero" id="home">

    <div class="hero-top">

        <div class="status">
            Available for creative projects
        </div>

        <div class="hero-location">
            Salem / Tamil Nadu<br>
            India
        </div>

    </div>

    <h1 class="reveal">

        DIGITAL

        <br>

        <span class="hero-indent">
            <em>CREATOR</em>
        </span>

        <br>

        DEVELOPER

    </h1>

    <div class="hero-bottom">

        <p class="hero-copy">
