<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description"
content="Neshik S S — Creative Developer, Web Developer & UI/UX Designer.">

<title>NESHIK® — Creative Developer</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@400;500;600;700&display=swap" rel="stylesheet">


<style>

/* =========================================================
   ROOT
========================================================= */

:root{

    --black:#101010;
    --black-soft:#171717;

    --cream:#f0ece3;
    --cream-soft:#e6e0d5;

    --gray:#858078;
    --gray-light:#aaa49a;

    --lime:#d8ff45;

    --line-dark:rgba(240,236,227,.14);
    --line-light:rgba(16,16,16,.14);

    --ease:cubic-bezier(.16,.75,.18,1);

}


/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    background:var(--black);

    color:var(--cream);

    font-family:"DM Sans",sans-serif;

    overflow-x:hidden;

}

body.menu-open{
    overflow:hidden;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input{
    font:inherit;
}

button{
    border:0;
    background:none;
    color:inherit;
    cursor:pointer;
}

::selection{
    background:var(--lime);
    color:#111;
}


/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar{
    width:6px;
}

::-webkit-scrollbar-track{
    background:var(--black);
}

::-webkit-scrollbar-thumb{
    background:#555;
    border-radius:20px;
}


/* =========================================================
   LOADER
========================================================= */

.loader{

    position:fixed;

    inset:0;

    z-index:99999;

    background:var(--black);

    display:flex;

    align-items:center;

    justify-content:center;

    transition:
        transform 1s var(--ease);

}

.loader.hide{
    transform:translateY(-100%);
}

.loader-content{
    text-align:center;
}

.loader-number{

    font-size:
        clamp(80px,15vw,190px);

    font-weight:700;

    line-height:.7;

    letter-spacing:-.1em;

}

.loader-label{

    margin-top:30px;

    font-size:9px;

    color:var(--gray);

    text-transform:uppercase;

    letter-spacing:.35em;

}


/* =========================================================
   NAVIGATION
========================================================= */

.nav{

    position:fixed;

    top:0;
    left:0;

    width:100%;

    z-index:5000;

    padding:
        25px 4vw;

    display:flex;

    align-items:center;

    justify-content:space-between;

    mix-blend-mode:difference;

}

.logo{

    font-size:21px;

    font-weight:700;

    letter-spacing:-.08em;

}

.nav-links{

    display:flex;

    gap:35px;

}

.nav-links a{

    font-size:9px;

    text-transform:uppercase;

    letter-spacing:.2em;

    position:relative;

}

.nav-links a::after{

    content:"";

    position:absolute;

    bottom:-7px;
    left:0;

    width:0;
    height:1px;

    background:#fff;

    transition:.3s;

}

.nav-links a:hover::after{
    width:100%;
}

.menu{
    display:none;

    font-size:9px;

    letter-spacing:.2em;

}


/* =========================================================
   HERO
========================================================= */

.hero{

    min-height:100svh;

    padding:
        145px 4vw 55px;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

}

.hero-top{

    display:flex;

    justify-content:space-between;

}

.availability{

    font-size:9px;

    color:var(--gray);

    letter-spacing:.2em;

    text-transform:uppercase;

}

.availability::before{

    content:"";

    width:7px;
    height:7px;

    border-radius:50%;

    display:inline-block;

    background:var(--lime);

    margin-right:9px;

    animation:pulse 1.6s infinite;

}

@keyframes pulse{

    50%{
        opacity:.3;
        transform:scale(.7);
    }

}

.location{

    text-align:right;

    font-size:9px;

    color:var(--gray);

    letter-spacing:.17em;

    text-transform:uppercase;

    line-height:1.8;

}


.hero-title{

    font-size:
        clamp(75px,14vw,210px);

    font-weight:700;

    letter-spacing:-.115em;

    line-height:.72;

}

.hero-title em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.hero-indent{

    margin-left:12vw;

}

.hero-bottom{

    display:flex;

    justify-content:space-between;

    align-items:flex-end;

}

.hero-description{

    width:370px;

    color:var(--gray-light);

    font-size:13px;

    line-height:1.8;

}

.scroll-label{

    color:var(--gray);

    font-size:9px;

    text-transform:uppercase;

    letter-spacing:.22em;

}


/* =========================================================
   MARQUEE
========================================================= */

.marquee{

    overflow:hidden;

    white-space:nowrap;

    padding:23px 0;

    border-top:
        1px solid var(--line-dark);

    border-bottom:
        1px solid var(--line-dark);

}

.marquee-track{

    display:inline-flex;

    animation:
        marquee 28s linear infinite;

}

.marquee span{

    margin-right:70px;

    color:var(--gray);

    font-size:9px;

    text-transform:uppercase;

    letter-spacing:.3em;

}

.marquee strong{
    color:var(--cream);
}

@keyframes marquee{

    from{
        transform:translateX(0);
    }

    to{
        transform:translateX(-50%);
    }

}


/* =========================================================
   COMMON SECTION
========================================================= */

.section{

    padding:
        150px 4vw;

}

.section-label{

    margin-bottom:65px;

    color:var(--gray);

    font-size:9px;

    letter-spacing:.3em;

    text-transform:uppercase;

}


/* =========================================================
   REVEAL
========================================================= */

.reveal{

    opacity:0;

    transform:translateY(45px);

    transition:

        opacity .9s ease,

        transform 1s var(--ease);

}

.reveal.visible{

    opacity:1;

    transform:none;

}


/* =========================================================
   ABOUT
========================================================= */

.about-grid{

    display:grid;

    grid-template-columns:
        1fr 2fr;

    gap:8vw;

}

.about-title{

    font-size:
        clamp(60px,8vw,120px);

    line-height:.78;

    letter-spacing:-.105em;

}

.about-title em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.about-main{

    font-size:
        clamp(25px,3.5vw,50px);

    line-height:1.05;

    letter-spacing:-.055em;

}

.about-text{

    max-width:700px;

    margin-top:45px;

    color:var(--gray);

    font-size:14px;

    line-height:1.9;

}

.about-stats{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    margin-top:75px;

    border-top:
        1px solid var(--line-dark);

}

.stat{

    padding-top:20px;

}

.stat-label{

    color:var(--gray);

    font-size:8px;

    text-transform:uppercase;

    letter-spacing:.2em;

    margin-bottom:10px;

}

.stat-value{

    font-size:14px;

}


/* =========================================================
   PHOTO
========================================================= */

.photo-section{

    padding-top:20px;

}

.photo-grid{

    display:grid;

    grid-template-columns:
        1.55fr .45fr;

    gap:30px;

    align-items:end;

}

.photo{

    position:relative;

    overflow:hidden;

    aspect-ratio:16/10;

    background:#222;

}

.photo img{

    width:100%;
    height:100%;

    object-fit:cover;

    transition:
        transform 1.2s var(--ease);

}

.photo:hover img{

    transform:
        scale(1.045);

}

.photo-overlay{

    position:absolute;

    left:20px;
    right:20px;
    bottom:20px;

    display:flex;

    justify-content:space-between;

}

.photo-tag{

    padding:9px 12px;

    background:
        rgba(0,0,0,.65);

    backdrop-filter:blur(12px);

    font-size:8px;

    text-transform:uppercase;

    letter-spacing:.17em;

}

.photo-message{

    font-size:
        clamp(32px,4vw,65px);

    line-height:.88;

    letter-spacing:-.07em;

}

.photo-message em{

    font-family:
        "Playfair Display",
        serif;

}


/* =========================================================
   SKILLS LIGHT SECTION
========================================================= */

.skills-section{

    background:var(--cream);

    color:var(--black);

}

.skills-section .section-label{

    color:#77736b;

}

.skills-heading{

    font-size:
        clamp(70px,11vw,160px);

    line-height:.73;

    letter-spacing:-.11em;

}

.skills-heading em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.skills-list{

    margin-top:110px;

    border-top:
        1px solid var(--line-light);

}

.skill-row{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:26px 0;

    border-bottom:
        1px solid var(--line-light);

    transition:
        padding .45s var(--ease);

}

.skill-row:hover{

    padding-left:25px;

    padding-right:25px;

}

.skill-name{

    font-size:
        clamp(27px,4vw,58px);

    letter-spacing:-.06em;

}

.skill-number{

    font-size:8px;

    color:#77736b;

}


/* =========================================================
   PROJECTS
========================================================= */

.projects-header{

    display:flex;

    justify-content:space-between;

    align-items:flex-end;

    gap:50px;

}

.projects-title{

    font-size:
        clamp(75px,12vw,175px);

    line-height:.7;

    letter-spacing:-.115em;

}

.projects-title em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.projects-description{

    width:300px;

    color:var(--gray);

    font-size:12px;

    line-height:1.8;

}


/* =========================================================
   SEARCH
========================================================= */

.project-tools{

    margin-top:90px;

    padding-bottom:20px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    border-bottom:
        1px solid var(--line-dark);

}

.project-total{

    color:var(--gray);

    font-size:9px;

    letter-spacing:.2em;

    text-transform:uppercase;

}

.search-box{

    width:250px;

    padding:10px 0;

    color:var(--cream);

    background:none;

    border:0;

    border-bottom:
        1px solid var(--line-dark);

    outline:none;

    font-size:11px;

}

.search-box::placeholder{

    color:var(--gray);

}


/* =========================================================
   BEST PROJECT GRID
========================================================= */

.project-grid{

    margin-top:55px;

    display:grid;

    grid-template-columns:
        repeat(12,1fr);

    gap:1px;

    border-top:
        1px solid var(--line-dark);

    border-left:
        1px solid var(--line-dark);

}


/* every card */

.project{

    position:relative;

    min-height:230px;

    padding:25px;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

    border-right:
        1px solid var(--line-dark);

    border-bottom:
        1px solid var(--line-dark);

    overflow:hidden;

    cursor:pointer;

    transition:
        background .5s var(--ease),
        color .5s var(--ease);

}


/* asymmetric grid */

.project:nth-child(1),
.project:nth-child(8),
.project:nth-child(15),
.project:nth-child(22),
.project:nth-child(29),
.project:nth-child(36),
.project:nth-child(43),
.project:nth-child(50),
.project:nth-child(57){

    grid-column:span 5;

    min-height:350px;

}

.project:nth-child(2),
.project:nth-child(9),
.project:nth-child(16),
.project:nth-child(23),
.project:nth-child(30),
.project:nth-child(37),
.project:nth-child(44),
.project:nth-child(51),
.project:nth-child(58){

    grid-column:span 4;

}

.project:nth-child(3),
.project:nth-child(10),
.project:nth-child(17),
.project:nth-child(24),
.project:nth-child(31),
.project:nth-child(38),
.project:nth-child(45),
.project:nth-child(52),
.project:nth-child(59){

    grid-column:span 3;

}

.project:nth-child(4),
.project:nth-child(11),
.project:nth-child(18),
.project:nth-child(25),
.project:nth-child(32),
.project:nth-child(39),
.project:nth-child(46),
.project:nth-child(53),
.project:nth-child(60){

    grid-column:span 3;

}

.project:nth-child(5),
.project:nth-child(12),
.project:nth-child(19),
.project:nth-child(26),
.project:nth-child(33),
.project:nth-child(40),
.project:nth-child(47),
.project:nth-child(54),
.project:nth-child(61){

    grid-column:span 4;

}

.project:nth-child(6),
.project:nth-child(13),
.project:nth-child(20),
.project:nth-child(27),
.project:nth-child(34),
.project:nth-child(41),
.project:nth-child(48),
.project:nth-child(55),
.project:nth-child(62){

    grid-column:span 5;

    min-height:300px;

}

.project:nth-child(7),
.project:nth-child(14),
.project:nth-child(21),
.project:nth-child(28),
.project:nth-child(35),
.project:nth-child(42),
.project:nth-child(49),
.project:nth-child(56),
.project:nth-child(63){

    grid-column:span 4;

}


/* hover */

.project::before{

    content:"";

    position:absolute;

    width:0;
    height:0;

    right:-60px;
    bottom:-60px;

    border-radius:50%;

    background:var(--lime);

    transition:
        width .7s var(--ease),
        height .7s var(--ease);

}

.project:hover::before{

    width:220px;
    height:220px;

}

.project:hover{

    color:#111;

    background:
        var(--cream);

}

.project-number{

    position:relative;

    z-index:2;

    color:var(--gray);

    font-size:8px;

    letter-spacing:.2em;

}

.project:hover .project-number{

    color:#777;

}

.project-name{

    position:relative;

    z-index:2;

    max-width:95%;

    font-size:
        clamp(23px,2.7vw,45px);

    line-height:.95;

    letter-spacing:-.065em;

    transition:
        transform .6s var(--ease);

}

.project:hover .project-name{

    transform:
        translateY(-7px);

}


/* tiny arrow */

.project-arrow{

    position:relative;

    z-index:2;

    align-self:flex-end;

    font-size:16px;

    opacity:.45;

    transition:.4s;

}

.project:hover .project-arrow{

    opacity:1;

    transform:
        translate(5px,-5px);

}


/* hidden search items */

.project.hidden{

    display:none;

}


/* =========================================================
   JOURNEY
========================================================= */

.journey{

    background:var(--cream);

    color:var(--black);

}

.journey-grid{

    display:grid;

    grid-template-columns:
        1fr 2fr;

    gap:8vw;

}

.journey-title{

    font-size:
        clamp(60px,8vw,125px);

    line-height:.76;

    letter-spacing:-.1em;

}

.journey-title em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.timeline{

    border-top:
        1px solid var(--line-light);

}

.timeline-item{

    display:grid;

    grid-template-columns:
        80px 1fr 100px;

    gap:20px;

    padding:32px 0;

    border-bottom:
        1px solid var(--line-light);

}

.timeline-year{

    color:#77736b;

    font-size:9px;

}

.timeline-role{

    font-size:22px;

    letter-spacing:-.04em;

}

.timeline-type{

    color:#77736b;

    text-align:right;

    font-size:8px;

    text-transform:uppercase;

    letter-spacing:.15em;

}


/* =========================================================
   CONTACT
========================================================= */

.contact{

    min-height:100svh;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

}

.contact-title{

    font-size:
        clamp(75px,12vw,180px);

    line-height:.7;

    letter-spacing:-.115em;

}

.contact-title em{

    font-family:
        "Playfair Display",
        serif;

    font-weight:500;

}

.contact-link{

    display:inline-block;

    margin-top:85px;

    padding-bottom:9px;

    border-bottom:
        2px solid var(--cream);

    font-size:
        clamp(23px,4vw,55px);

    letter-spacing:-.06em;

    transition:.4s;

}

.contact-link:hover{

    opacity:.5;

    transform:
        translateX(10px);

}

.footer{

    padding-top:25px;

    border-top:
        1px solid var(--line-dark);

    display:flex;

    justify-content:space-between;

    align-items:center;

}

.social-links{

    display:flex;

    gap:30px;

}

.social-links a{

    font-size:8px;

    text-transform:uppercase;

    letter-spacing:.18em;

}

.social-links a:hover{
    text-decoration:underline;
}

.copyright{

    color:var(--gray);

    font-size:8px;

    letter-spacing:.1em;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

    .nav{
        padding:20px;
    }

    .menu{
        display:block;
    }

    .nav-links{

        position:fixed;

        inset:0;

        background:var(--black);

        display:flex;

        flex-direction:column;

        justify-content:center;

        align-items:center;

        gap:30px;

        transform:
            translateY(-100%);

        transition:
            transform .7s var(--ease);

    }

    .nav-links.open{
        transform:none;
    }

    .nav-links a{

        font-size:30px;

        letter-spacing:-.05em;

        text-transform:none;

    }

    .hero{

        padding:
            110px 20px 40px;

    }

    .hero-title{

        font-size:19vw;

    }

    .hero-indent{

        margin-left:4vw;

    }

    .location{
        display:none;
    }

    .hero-bottom{

        flex-direction:column;

        align-items:flex-start;

        gap:35px;

        margin-top:90px;

    }

    .hero-description{
        width:100%;
    }

    .section{
        padding:
            100px 20px;
    }

    .about-grid{

        grid-template-columns:1fr;

        gap:55px;

    }

    .about-stats{

        grid-template-columns:
            repeat(2,1fr);

        gap:30px;

    }

    .photo-grid{

        grid-template-columns:1fr;

    }

    .photo{

        aspect-ratio:4/5;

    }

    .photo-message{

        max-width:300px;

    }

    .skills-list{
        margin-top:70px;
    }

    .projects-header{

        display:block;

    }

    .projects-description{

        width:auto;

        margin-top:35px;

    }

    .project-tools{

        display:block;

    }

    .search-box{

        width:100%;

        margin-top:25px;

    }

    .project-grid{

        display:block;

    }

    .project{

        min-height:270px !important;

    }

    .journey-grid{

        grid-template-columns:1fr;

        gap:60px;

    }

    .timeline-item{

        grid-template-columns:
            60px 1fr;

    }

    .timeline-type{

        grid-column:2;

        text-align:left;

    }

    .footer{

        flex-direction:column;

        align-items:flex-start;

        gap:30px;

    }

    .social-links{

        flex-wrap:wrap;

    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{

        animation-duration:.01ms !important;

        transition-duration:.01ms !important;

        scroll-behavior:auto !important;

    }

}

</style>

</head>


<body>


<!-- =======================================================
     LOADER
======================================================= -->

<div class="loader" id="loader">

    <div class="loader-content">

        <div
            class="loader-number"
            id="loaderNumber">
            0
        </div>

        <div class="loader-label">
            Neshik / Portfolio
        </div>

    </div>

</div>



<!-- =======================================================
     NAVIGATION
======================================================= -->

<nav class="nav">

    <a
        href="#home"
        class="logo">
        NESHIK®
    </a>


    <div
        class="nav-links"
        id="navLinks">

        <a href="#about">
            About
        </a>

        <a href="#skills">
            Skills
        </a>

        <a href="#projects">
            Work
        </a>

        <a href="#journey">
            Journey
        </a>

        <a href="#contact">
            Contact
        </a>

    </div>


    <button
        class="menu"
        id="menu">
        MENU
    </button>

</nav>



<!-- =======================================================
     HERO
======================================================= -->

<header
    class="hero"
    id="home">


    <div class="hero-top">

        <div class="availability">
            Available for creative projects
        </div>

        <div class="location">
            Salem / Tamil Nadu
            <br>
            India
        </div>

    </div>


    <h1
        class="hero-title reveal">

        DIGITAL

        <br>

        <span class="hero-indent">

            <em>CREATOR</em>

        </span>

        <br>

        NESHIK

    </h1>


    <div class="hero-bottom">

        <p class="hero-description">

